{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-psap/inference-playbooks/schema/recipe.schema.json",
  "title": "Inference Playbook Recipe",
  "type": "object",
  "required": [
    "schema_version", "recipe_id", "model_id", "platform",
    "hardware_profile", "workload_profile", "deployment_mode",
    "optimization_intent", "maturity", "deployment"
  ],
  "$defs": {
    "status": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["verified", "derived", "needs-verification"]},
        "date": {"type": "string", "format": "date"},
        "method": {"type": "string"},
        "note": {"type": "string"},
        "derived_from": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "verified"}}},
          "then": {"required": ["date", "method"]}
        },
        {
          "if": {"properties": {"state": {"const": "derived"}}},
          "then": {"required": ["derived_from"]}
        },
        {
          "if": {"properties": {"state": {"const": "needs-verification"}}},
          "then": {"required": ["note"]}
        }
      ]
    },
    "serving": {
      "type": "object",
      "required": ["image", "model", "parallelism", "args"],
      "properties": {
        "image": {
          "type": "string",
          "description": "Fully qualified container image reference"
        },
        "model": {
          "type": "string",
          "description": "HuggingFace model ID passed to vllm serve"
        },
        "parallelism": {
          "type": "object",
          "required": ["mode", "tp"],
          "properties": {
            "mode": {
              "enum": ["tp", "pp", "tp+pp", "dp", "tp+dp"]
            },
            "tp": {"type": "integer", "minimum": 1},
            "pp": {"type": "integer", "minimum": 1, "default": 1},
            "dp": {"type": "integer", "minimum": 1, "default": 1}
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {"type": "string"},
                "memory": {"type": "string"}
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "value": {"type": "string"},
              "value_from": {"type": "object"}
            },
            "oneOf": [
              {"required": ["value"]},
              {"required": ["value_from"]}
            ]
          }
        },
        "port": {
          "type": "integer",
          "default": 8000,
          "minimum": 1,
          "maximum": 65535
        },
        "router": {
          "type": "object",
          "properties": {
            "strategy": {"type": "string"},
            "values": {"type": "string", "pattern": "^config/.*\\.ya?ml$"}
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag", "required", "why"],
            "properties": {
              "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
              "value": {"type": "string"},
              "required": {"type": "boolean"},
              "why": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "constraint_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag", "allow", "reason"],
            "properties": {
              "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
              "allow": {"const": true},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "config_overrides": {
          "type": "boolean",
          "description": "Set true when config/ contains Kustomize overlay patches"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"enum": [3, 4]},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "platform": {
      "type": "object",
      "required": ["stack", "version"],
      "properties": {
        "stack": {"enum": ["rhoai", "llm-d", "vllm"]},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
      }
    },
    "hardware_profile": {
      "type": "string",
      "pattern": "^hardware-profiles/[a-z0-9][a-z0-9._-]+\\.yaml$"
    },
    "workload_profile": {
      "enum": ["guidellm-8k1k", "aiperf-agentx-128k", "aiperf-agentx-unlimited-context"]
    },
    "deployment_mode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(--[a-z0-9][a-z0-9-]*)?$"
    },
    "optimization_intent": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog label. Use latency or throughput when applicable; custom text is allowed."
    },
    "maturity": {"enum": ["day-zero", "validated", "production"]},
    "serving": {"$ref": "#/$defs/serving"},
    "deployment": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"enum": ["single-node", "multi-node"]},
        "status": {"$ref": "#/$defs/status"},
        "components": {
          "type": "object",
          "description": "Named deployment components, each validated by its manifest-specific schema.",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
          "additionalProperties": {
            "oneOf": [
              {"$ref": "deployment.schema.json"},
              {"$ref": "llmisvc.schema.json"},
              {"$ref": "leaderworkerset.schema.json"},
              {"$ref": "llmd-router.schema.json"}
            ]
          },
          "minProperties": 1
        },
        "auxiliary_sources": {
          "type": "array",
          "description": "Additional editable manifests needed by the deployment, such as Services or operator configuration.",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "pattern": "^config/.*\\.ya?ml$"},
              "kind": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "pattern": "^manifests/"},
              "kind": {"type": "string"},
              "generated": {"type": "boolean"}
            }
          }
        }
      },
      "additionalProperties": false
    },
    "benchmark_runs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^results/.+/run\\.yaml$"}
    },
    "notes": {"type": "string", "pattern": "^guides/.*\\.ya?ml$"},
    "match": {
      "type": "object",
      "not": {"required": ["nodes"]},
      "description": "Catalog selectors may not contain nodes; use deployment.scope."
    }
  },
  "if": {
    "required": ["schema_version"],
    "properties": {"schema_version": {"const": 4}}
  },
  "then": {
    "required": ["serving"]
  },
  "else": {
    "properties": {
      "deployment": {
        "required": ["scope", "components"]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"maturity": {"enum": ["validated", "production"]}}},
      "then": {"required": ["benchmark_runs"]}
    }
  ]
}
